[Unit]
Description=CyberAcme YouTube to MP3 / MP4
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOURUSER
WorkingDirectory=/home/YOURUSER/cyberacme_yt2mp3-4
Environment="PATH=/home/YOURUSER/cyberacme_yt2mp3-4/.venv/bin:/home/YOURUSER/.deno/bin:/usr/local/bin:/usr/bin:/bin"
Environment="MAX_DURATION_SECONDS=14400"
ExecStart=/home/YOURUSER/cyberacme_yt2mp3-4/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 8 --timeout 120 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
